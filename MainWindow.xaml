<Window x:Class="UpLINE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UpLINE"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="LoginView" Visibility="Visible" Background="{StaticResource CanvasBrush}">
            <Grid Width="940" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10,0,0,10" Padding="48">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UPLINE" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Windows向けLINEクライアント" FontSize="34" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <TextBlock Text="会話をすばやく、安全に扱うためのデスクトップアプリです。" Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="Wrap" LineHeight="24" />
                        <Border Background="{StaticResource PanelElevatedBrush}" CornerRadius="6" Padding="16" Margin="0,36,0,0">
                            <StackPanel>
                                <TextBlock Text="セキュリティ" FontWeight="SemiBold" />
                                <TextBlock Text="認証情報はWindows DPAPIで暗号化。トークンや秘密鍵をログへ出しません。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelElevatedBrush}" CornerRadius="0,10,10,0" Padding="44">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ログイン" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="LINEアプリでQRコードを読み取ってください" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,24" />
                        <Border Background="White" CornerRadius="8" Padding="14" HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Width="248" Height="248" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="LoginStatusText" Text="QRコードを準備しています…" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Width="320" Margin="0,18,0,0" />
                        <Border x:Name="PinPanel" Visibility="Collapsed" Background="{StaticResource InputBrush}" CornerRadius="6" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="メイン端末でこのPINを確認" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PinText" Text="------" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RetryLoginButton" Content="新しいQRコードを作成" Style="{StaticResource GhostButton}" Click="RetryLoginButton_Click" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed" Background="{StaticResource CanvasBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="224" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#101114" Padding="12,18">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="U" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="4,18,4,14" />
                    <Button Content="⌂" FontSize="25" ToolTip="ホーム" Click="HomeButton_Click" />
                    <Button Content="✉" FontSize="21" ToolTip="メッセージ" Margin="0,5,0,0" Click="MessagesButton_Click" />
                    <Button Content="♧" FontSize="23" ToolTip="連絡先" Margin="0,5,0,0" Click="ContactsButton_Click" />
                    <Button Content="⚙" FontSize="21" ToolTip="設定" Margin="0,5,0,0" Click="SettingsButton_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="74" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                    <TextBlock Text="UpLINE" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Row="1" Margin="10,16">
                    <TextBlock Text="ダイレクトメッセージ" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="10,0,0,8" />
                    <ListBox x:Name="ChatList" SelectionChanged="ChatList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8" Margin="0,1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BorderBrush}">
                                            <TextBlock Text="{Binding Name}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding UnreadCount}" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource InputBrush}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="U" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountNameText" Text="LINEユーザー" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="オンライン" Foreground="{StaticResource OnlineBrush}" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="⇥" FontSize="18" ToolTip="ログアウト" Click="LogoutButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Background="{StaticResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConversationTitle" Text="ホーム" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ConversationSubtitle" Text="安全なデスクトップ接続" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBlock Grid.Column="2" Text="●  接続済み" Foreground="{StaticResource OnlineBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <StackPanel x:Name="MessagePanel">
                        <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,110,0,70">
                            <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="U" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="UpLINEへようこそ" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                            <TextBlock Text="左のトークを選択すると、ここに会話が表示されます。" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="{StaticResource InputBrush}" CornerRadius="6" Margin="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageTextBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" TextChanged="MessageTextBox_TextChanged" KeyDown="MessageTextBox_KeyDown" />
                        <Button Grid.Column="1" x:Name="SendButton" Content="送信" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="SendButton_Click" Margin="0" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" Padding="16,20">
                <StackPanel>
                    <TextBlock Text="メンバー" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,12" />
                    <StackPanel x:Name="MemberPanel" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
